{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PocketSmart: Start app",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "pocketsmart-server",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Application startup complete"
				}
			}
		},
		{
			"label": "PocketSmart: Run tests",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pytest",
				"-q"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}